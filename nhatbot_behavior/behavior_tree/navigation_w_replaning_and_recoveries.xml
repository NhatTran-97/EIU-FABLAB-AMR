<root BTCPP_format="4">
  <BehaviorTree ID="Untitled">
    <RecoveryNode number_of_retries="2">
      <PipelineSequence>
        <RateController hz="1">
          <ComputePathToPose goal="{goal}"
                             planner_id="GridBased_ThetaStarPlanner_nav2"
                             path="{path}"/>
        </RateController>
        <FollowPath controller_id="FollowPath_DWB"
                    path="{path}"/>
      </PipelineSequence>
      <Sequence>
        <Spin spin_dist="1.57"/>
        <Wait wait_duration="5"/>
        <BackUp backup_dist="0.3" backup_speed="0.15"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>

</root>
